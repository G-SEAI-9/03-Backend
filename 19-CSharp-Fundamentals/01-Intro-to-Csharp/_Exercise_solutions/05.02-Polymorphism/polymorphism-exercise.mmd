        +AccessPass(holder: string)
        +Validate() bool
    }
    class MetroPass {
        +Zones : int
        +MetroPass(holder: string, zones: int)
        +Validate() bool
    }
    class BikeSharePass {
        +RemainingMinutes : int
        +BikeSharePass(holder: string, remainingMinutes: int)
        +Validate() bool
    }
    class FerryPass {
        +Expiry : DateOnly
        +FerryPass(holder: string, expiry: DateOnly)
        +Validate() bool
    }
    AccessPass <|-- MetroPass
    AccessPass <|-- BikeSharePass
    AccessPass <|-- FerryPass
    note for AccessPass "Validate ist virtual#nbsp;#nbsp;#nbsp;"
    note for FerryPass "sealed override:#nbsp;#nbsp;#nbsp;<br>Kindklassen dürfen Validate#nbsp;#nbsp;#nbsp;<br>nicht mehr überschreiben#nbsp;#nbsp;#nbsp;"
