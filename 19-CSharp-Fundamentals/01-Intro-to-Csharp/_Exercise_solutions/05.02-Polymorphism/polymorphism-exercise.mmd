classDiagram
    direction TB

    %% Aufgabe 1: GameCharacter
    class GameCharacter {
        +Name : string
        +Level : int
        +GameCharacter(name: string, level: int)
        +UseSpecial() void
        +Describe() void
    }
    class Warrior {
        +Warrior(name: string, level: int)
        +UseSpecial() void
        +Describe() void
    }
    class Mage {
        +Mage(name: string, level: int)
        +UseSpecial() void
        +Describe() void
    }
    class Healer {
        +Healer(name: string, level: int)
        +UseSpecial() void
        +Describe() void
    }
    class Rogue {
        +Rogue(name: string, level: int)
        +UseSpecial() void
        +Describe() void
    }
    GameCharacter <|-- Warrior
    GameCharacter <|-- Mage
    GameCharacter <|-- Healer
    GameCharacter <|-- Rogue
    note for GameCharacter "UseSpecial und Describe#nbsp;#nbsp;#nbsp;<br>sind virtual#nbsp;#nbsp;#nbsp;"
    note for Rogue "Describe mit new statt override:#nbsp;#nbsp;#nbsp;<br>Über eine GameCharacter-#nbsp;#nbsp;#nbsp;<br>Referenz läuft#nbsp;#nbsp;#nbsp;<br>GameCharacter.Describe#nbsp;#nbsp;#nbsp;"

    %% Aufgabe 2: Exporter
    class Exporter {
        <<abstract>>
        +FileName : string
        #Exporter(fileName: string)
        +Export(content: string)* void
        #PrintStart(format: string) void
    }
    class PdfExporter {
        +PdfExporter(fileName: string)
        +Export(content: string) void
    }
    class CsvExporter {
        +CsvExporter(fileName: string)
        +Export(content: string) void
    }
    class HtmlExporter {
        +HtmlExporter(fileName: string)
        +Export(content: string) void
    }
    class MarkdownExporter {
        +MarkdownExporter(fileName: string)
        +Export(content: string) void
    }
    Exporter <|-- PdfExporter
    Exporter <|-- CsvExporter
    Exporter <|-- HtmlExporter
    Exporter <|-- MarkdownExporter
    note for Exporter "Export ist abstract:#nbsp;#nbsp;#nbsp;<br>kein Body, jede Kindklasse#nbsp;#nbsp;#nbsp;<br>muss override schreiben#nbsp;#nbsp;#nbsp;"

